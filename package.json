{
  "name": "lepak-city",
  "version": "1.0.0",
  "description": "A stylised Kuala Lumpur browser game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "start": "node server/index.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lepak-city --branch main",
    "deploy:realtime": "railway up --service 9a776d22-a5d8-4151-8059-300149fce72c --detach --yes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "private": true
}
