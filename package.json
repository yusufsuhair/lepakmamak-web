{
  "name": "lepakmamak",
  "version": "1.27.0",
  "description": "A stylised Kuala Lumpur browser game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch scripts/dev-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test && npm --prefix admin test",
    "start": "node server/index.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lepakmamak --branch main",
    "deploy:realtime": "node scripts/deploy-realtime.mjs",
    "preversion": "npm run build && npm test",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "app:ios": "npm run build && cap sync ios && cap run ios",
    "app:android": "npm run build && cap sync android && cap run android",
    "deploy:realtime:dev": "node scripts/deploy-realtime.mjs --dev",
    "deploy:dev": "vite build --mode dev && wrangler pages deploy dist --project-name lepakmamak-dev --branch main"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@fontsource/oxanium": "^5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "stripe": "^22.4.0",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "private": true
}
