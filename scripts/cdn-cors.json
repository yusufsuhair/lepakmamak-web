{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://game.example.com",
          "https://your-pages-project.pages.dev",
          "http://localhost:4173",
          "http://127.0.0.1:4173"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range"
        ]
      },
      "exposeHeaders": [
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "ETag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
