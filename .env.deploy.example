CF_PAGES_DEV_PROJECT=
CF_PAGES_HEALTH_PROJECT=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT=production
RAILWAY_DEV_SERVICE_ID=
RAILWAY_DEV_ENVIRONMENT=development
R2_BUCKET=
VITE_CDN_BASE_URL=
CDN_ORIGIN=
# Frontend VITE_* settings belong in .env.production.local / .env.dev.local.
# Optional: MIN_CLIENT_VERSION=0.0.0 (minimum client supported by a release).
