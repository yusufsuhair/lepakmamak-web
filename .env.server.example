# Copy to .env.server.local; npm run dev:server loads it.
# Local guest-only server. For public hosting configure Supabase and choose ALLOW_GUESTS.
PORT=8120
ALLOW_GUESTS=true
ALLOW_DEV_TOOLS=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Trusted Supabase Auth user UUIDs, comma-separated. Empty = no GMs.
GM_USER_IDS=
# Optional providers; NEVER copy these into VITE_* variables.
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ALERT_WEBHOOK_URL=
HEARTBEAT_URL=
# Optional tuning: GUEST_SEATS, WS_MAX_CONNECTIONS, WS_MAX_PER_ADDRESS,
# ALERT_BYTES_PER_SECOND, ALERT_SAMPLES, HEARTBEAT_SECONDS.
