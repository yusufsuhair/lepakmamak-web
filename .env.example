# Copy to .env.local for local development. All VITE_* values are PUBLIC.
VITE_MULTIPLAYER_URL=ws://localhost:8120
VITE_ALLOW_GUESTS=true
VITE_DEV_TOOLS=false
# Optional: use your own Supabase project for accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty = bundled public/ assets; for Pages use your own R2 custom domain.
VITE_CDN_BASE_URL=
